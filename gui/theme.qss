/* ============================================================================
   Fast BLF Converter — 暗色 Fluent Design QSS
   主目标平台: Windows 10/11 (PySide6 6.x)
   调色板:
     底色        #1E1E24      面板        #25252E
     卡片/输入框  #2D2D38      边框        #3A3A46
     主色/主按钮  #0078D4      悬停        #1A88E0      按下 #006CBE
     主文字      #E8E8F0      次要文字    #9A9AB0
     警示(琥珀)  #F0A020
   圆角统一 6–8px
   ========================================================================== */

/* ---------------------------------------------------------------- 基础 ---- */
QWidget {
    background-color: #1E1E24;
    color: #E8E8F0;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow {
    background-color: #1E1E24;
}

QMainWindow::separator {
    background-color: #3A3A46;
    width: 1px;
    height: 1px;
}

QToolTip {
    background-color: #2D2D38;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 6px 8px;
}

QLabel {
    background: transparent;
}

QLabel#hintLabel {
    color: #9A9AB0;
}

QFrame#controlPanel {
    background-color: #25252E;
    border: 1px solid #3A3A46;
    border-radius: 8px;
}

/* --------------------------------------------------------------- 工具栏 --- */
QToolBar {
    background-color: #25252E;
    border: none;
    border-bottom: 1px solid #3A3A46;
    padding: 8px 10px;
    spacing: 10px;
}

QToolBar::separator {
    background-color: #3A3A46;
    width: 1px;
    margin: 4px 6px;
}

QToolBar QLabel {
    color: #9A9AB0;
    padding-left: 4px;
}

QWidget#toolbarSpacer {
    background: transparent;
}

/* --------------------------------------------------------------- 按钮 ---- */
QPushButton {
    background-color: #2D2D38;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 7px 16px;
    min-height: 20px;
    min-width: 74px;
}

QPushButton:hover {
    background-color: #35353F;
    border-color: #4A4A58;
}

QPushButton:pressed {
    background-color: #23232B;
    border-color: #0078D4;
    color: #C8C8D8;
}

QPushButton:disabled {
    background-color: #262630;
    color: #6A6A7C;
    border-color: #33333D;
}

QPushButton:focus {
    border-color: #0078D4;
}

QPushButton#primaryButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #1A88E0;
    border-radius: 6px;
    padding: 9px 22px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1A88E0;
    border-color: #3D9BEA;
}

QPushButton#primaryButton:pressed {
    background-color: #006CBE;
    border-color: #005A9E;
}

QPushButton#primaryButton:disabled {
    background-color: #2A3A46;
    color: #7A8A96;
    border-color: #2F3F4B;
}

/* --------------------------------------------------------------- 下拉框 -- */
QComboBox {
    background-color: #2D2D38;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
    min-width: 90px;
}

QComboBox:hover {
    border-color: #4A4A58;
}

QComboBox:focus {
    border-color: #0078D4;
}

QComboBox:disabled {
    background-color: #262630;
    color: #6A6A7C;
    border-color: #33333D;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border-left: 1px solid #3A3A46;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #25252E;
}

QComboBox::drop-down:hover {
    background-color: #0078D4;
}

QComboBox::down-arrow {
    image: none;
    width: 8px;
    height: 8px;
    border-left: 2px solid #9A9AB0;
    border-bottom: 2px solid #9A9AB0;
    margin-right: 6px;
}

QComboBox::down-arrow:disabled {
    border-color: #5A5A6A;
}

QComboBox QAbstractItemView {
    background-color: #25252E;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    alternate-background-color: #25252E;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2D2D38;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

/* 未勾选“拆表”时高亮重采样下拉（配合 main.py 的 setProperty("warnHint")） */
QComboBox[warnHint="true"] {
    border: 1px solid #F0A020;
    background-color: #33291A;
    color: #F0A020;
}

QComboBox[warnHint="true"]::drop-down {
    border-left: 1px solid #F0A020;
    background-color: #33291A;
}

QComboBox[warnHint="true"]::down-arrow {
    border-left-color: #F0A020;
    border-bottom-color: #F0A020;
}

/* --------------------------------------------------------------- 复选框 -- */
QCheckBox {
    background: transparent;
    color: #E8E8F0;
    spacing: 8px;
    padding: 2px 0;
}

QCheckBox:hover {
    color: #FFFFFF;
}

QCheckBox:disabled {
    color: #6A6A7C;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4A4A58;
    border-radius: 4px;
    background-color: #2D2D38;
}

QCheckBox::indicator:hover {
    border-color: #0078D4;
}

QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #1A88E0;
    border-color: #1A88E0;
}

QCheckBox::indicator:indeterminate {
    background-color: #006CBE;
    border-color: #0078D4;
    image: none;
}

QCheckBox::indicator:disabled {
    background-color: #262630;
    border-color: #33333D;
}

/* --------------------------------------------------------------- 输入框 -- */
QLineEdit {
    background-color: #2D2D38;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #4A4A58;
}

QLineEdit:focus {
    border-color: #0078D4;
    background-color: #30303C;
}

QLineEdit:disabled {
    background-color: #262630;
    color: #6A6A7C;
    border-color: #33333D;
}

QLineEdit[warnHint="true"] {
    border: 1px solid #F0A020;
    color: #F0A020;
}

/* --------------------------------------------------------- 树 / 列表视图 -- */
QTreeWidget,
QTreeView {
    background-color: #25252E;
    alternate-background-color: #2A2A33;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget::item,
QTreeView::item {
    min-height: 24px;
    padding: 2px 4px;
    border-radius: 4px;
    color: #E8E8F0;
}

QTreeWidget::item:hover,
QTreeView::item:hover {
    background-color: #2F2F3A;
}

QTreeWidget::item:selected,
QTreeView::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QTreeWidget::item:selected:!active,
QTreeView::item:selected:!active {
    background-color: #2C4A66;
    color: #E8E8F0;
}

QTreeWidget::branch,
QTreeView::branch {
    background: transparent;
}

/* 三态复选框（通道 / 报文 / 信号 三级全部可勾选） */
QTreeView::indicator,
QTreeWidget::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4A4A58;
    border-radius: 4px;
    background-color: #2D2D38;
}

QTreeView::indicator:hover,
QTreeWidget::indicator:hover {
    border-color: #0078D4;
}

QTreeView::indicator:checked,
QTreeWidget::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
}

QTreeView::indicator:indeterminate,
QTreeWidget::indicator:indeterminate {
    background-color: #006CBE;
    border-color: #0078D4;
}

QTreeView::indicator:disabled,
QTreeWidget::indicator:disabled {
    background-color: #262630;
    border-color: #33333D;
}

/* --------------------------------------------------------------- 表头 ---- */
QHeaderView {
    background-color: #25252E;
    border: none;
}

QHeaderView::section {
    background-color: #2D2D38;
    color: #9A9AB0;
    border: none;
    border-right: 1px solid #3A3A46;
    border-bottom: 1px solid #3A3A46;
    padding: 7px 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #35353F;
    color: #E8E8F0;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 6px;
}

QHeaderView::down-arrow,
QHeaderView::up-arrow {
    width: 8px;
    height: 8px;
    subcontrol-position: center right;
    right: 6px;
}

/* --------------------------------------------------------------- 进度条 -- */
QProgressBar {
    background-color: #2A2A33;
    border: 1px solid #3A3A46;
    border-radius: 7px;
    height: 16px;
    text-align: center;
    color: #E8E8F0;
    font-size: 11px;
}

QProgressBar:disabled {
    color: #6A6A7C;
}

QProgressBar::chunk {
    border-radius: 6px;
    margin: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #006CBE, stop:0.5 #0078D4, stop:1 #1A88E0);
}

/* --------------------------------------------------------------- 状态栏 -- */
QStatusBar {
    background-color: #25252E;
    color: #9A9AB0;
    border-top: 1px solid #3A3A46;
    padding: 2px 6px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #9A9AB0;
    padding: 2px 6px;
}

QStatusBar QLabel#statusPrimary {
    color: #E8E8F0;
}

/* ----------------------------------------------------------- 分割器 ------ */
QSplitter {
    background-color: #1E1E24;
}

QSplitter::handle {
    background-color: #3A3A46;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #0078D4;
}

QSplitter::handle:pressed {
    background-color: #006CBE;
}

/* --------------------------------------------------------------- 滚动条 -- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px 2px 2px 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3A3A46;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4E4E5C;
}

QScrollBar::handle:vertical:pressed {
    background-color: #0078D4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0 2px 2px 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A46;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4E4E5C;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #0078D4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::corner {
    background: transparent;
    border: none;
}

/* --------------------------------------------------------------- 菜单 ---- */
QMenu {
    background-color: #25252E;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    background: transparent;
    padding: 7px 22px 7px 14px;
    border-radius: 6px;
    min-width: 120px;
}

QMenu::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #6A6A7C;
}

QMenu::separator {
    height: 1px;
    background-color: #3A3A46;
    margin: 5px 8px;
}

QMenu::icon {
    margin-left: 6px;
}

QMenuBar {
    background-color: #25252E;
    color: #E8E8F0;
    border-bottom: 1px solid #3A3A46;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #2D2D38;
}

/* ----------------------------------------------------------- 消息框 ------- */
QMessageBox {
    background-color: #25252E;
    border: 1px solid #3A3A46;
    border-radius: 8px;
}

QMessageBox QLabel {
    background: transparent;
    color: #E8E8F0;
    font-size: 13px;
    padding: 4px;
    min-width: 260px;
}

QMessageBox QPushButton {
    background-color: #2D2D38;
    color: #E8E8F0;
    border: 1px solid #3A3A46;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 72px;
}

QMessageBox QPushButton:hover {
    background-color: #35353F;
    border-color: #0078D4;
}

QMessageBox QPushButton:pressed {
    background-color: #23232B;
    border-color: #006CBE;
}

QMessageBox QPushButton:default {
    background-color: #0078D4;
    color: #FFFFFF;
    border-color: #1A88E0;
}

QMessageBox QPushButton:default:hover {
    background-color: #1A88E0;
}

/* --------------------------------------------------- 复用对象名样式 ------- */
/* #warnHint：琥珀色文字 + 边框，用于“建议重采样”等提示 */
QLabel#warnHint,
QLabel#warnHint:disabled {
    background-color: #33291A;
    color: #F0A020;
    border: 1px solid #F0A020;
    border-radius: 6px;
    padding: 6px 10px;
}

/* #primaryButton 已在“按钮”一节定义，此处仅保留对象名可复用意（无重复声明） */

/* ----------------------------------------------------------- 其他控件 ---- */
QGroupBox {
    background-color: #25252E;
    border: 1px solid #3A3A46;
    border-radius: 8px;
    margin-top: 12px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #9A9AB0;
}

QDialog {
    background-color: #25252E;
}

QAbstractScrollArea {
    background-color: #25252E;
    border: none;
}

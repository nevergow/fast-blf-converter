# Rust / Python 构建产物
/target/
**/*.rs.bk

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# maturin / 打包产物
/dist/
/build/
*.egg-info/

# 运行期产物
/out/
/tmp/
*.xlsx
*.parquet
*.csv
!docs/**/*.csv

# 用户配置预设（configs/*.json 是本机/随包的运行时数据，不进仓库）
/configs/

# 生成的基准/大素材（体积大，用脚本重新生成即可）
fixtures/bench_*.blf

# macOS
.DS_Store

# 保留构建脚本与 GUI（注意：只放行源码与样式，不要用 !gui/** —— 那会把 __pycache__ 一起放回来）
!build_windows_portable.bat
!gui/*.py
!gui/*.qss
